# ==============================================================================
# ft_transcendence — Environment Variable Template
# ==============================================================================
# Copy this file to .env and fill in real values before running the project.
# NEVER commit the actual .env file to version control.
# This file is safe to commit — it contains only placeholder values.
# ==============================================================================

# ------------------------------------------------------------------------------
# PROJECT
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=transcendence

# The domain name used for HTTPS and Nginx virtual host configuration.
# Use localhost for local development; set your real domain in production.
DOMAIN_NAME=localhost

# ------------------------------------------------------------------------------
# PORTS — External ports exposed on the host machine
# ------------------------------------------------------------------------------
# Nginx reverse proxy (HTTPS only — HTTP redirects to HTTPS)
HTTPS_PORT=443
HTTP_PORT=80

# Portainer web UI (disable for production / evaluation)
PORTAINER_PORT=9443

# Monitoring dashboard (disable or restrict in production)
MONITORING_PORT=3000

# ------------------------------------------------------------------------------
# DATABASE — PostgreSQL
# ------------------------------------------------------------------------------
# Name of the default database to create on first boot
POSTGRES_DB=transcendence_db

# Superuser credentials (use Docker Secrets in production instead of plain vars)
POSTGRES_USER=transcendence_user
POSTGRES_PASSWORD=changeme_strong_password_here

# Internal port (not exposed externally — backend reaches it via Docker network)
POSTGRES_PORT=5432

# Host path for database initialisation scripts (optional)
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C

# ------------------------------------------------------------------------------
# REDIS
# ------------------------------------------------------------------------------
# Redis password (leave empty to disable auth — not recommended for production)
REDIS_PASSWORD=changeme_redis_password_here

# Internal port
REDIS_PORT=6379

# Maximum memory Redis is allowed to use before evicting keys
REDIS_MAX_MEMORY=256mb

# Eviction policy when maxmemory is reached.
# Options: noeviction | allkeys-lru | volatile-lru | allkeys-random | etc.
REDIS_MAX_MEMORY_POLICY=allkeys-lru

# ------------------------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------------------------
# Set to 'development' or 'production'
BACKEND_ENV=development

# Secret key used by the backend framework for signing tokens / sessions.
# Generate a strong random string: openssl rand -hex 32
SECRET_KEY=changeme_very_long_random_secret_key_here

# Django / FastAPI / Express — depends on chosen stack
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=https://localhost,https://127.0.0.1

# JWT configuration
JWT_SECRET=changeme_jwt_secret
JWT_EXPIRY=3600
REFRESH_TOKEN_EXPIRY=86400

# ------------------------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------------------------
# Build mode: 'development' enables hot reload, 'production' runs static build
FRONTEND_ENV=development

FRONTEND_PORT=3000

# API URL the browser uses to reach the backend (proxied through Nginx)
VITE_API_URL=https://localhost/api
REACT_APP_API_URL=https://localhost/api

# ------------------------------------------------------------------------------
# TLS / SSL CERTIFICATES
# ------------------------------------------------------------------------------
# Path inside the reverse_proxy container where certificates are mounted
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Self-signed cert expiry (used for local development only)
SSL_SELF_SIGNED_DAYS=365

# Set to 'letsencrypt' to switch to Let's Encrypt in the Nginx config
SSL_PROVIDER=self-signed

# Let's Encrypt email (only used when SSL_PROVIDER=letsencrypt)
LETSENCRYPT_EMAIL=your-email@example.com

# ------------------------------------------------------------------------------
# MONITORING
# ------------------------------------------------------------------------------
# Grafana admin credentials
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=changeme_grafana_password

# Prometheus scrape interval
PROMETHEUS_SCRAPE_INTERVAL=15s

# Loki log retention
LOKI_RETENTION_PERIOD=720h

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
# Log level: debug | info | warning | error | critical
LOG_LEVEL=info

# Log driver: json-file | syslog | journald | fluentd | loki
LOG_DRIVER=json-file

# Maximum log file size before rotation
LOG_MAX_SIZE=10m

# Number of rotated log files to keep
LOG_MAX_FILE=3

# ------------------------------------------------------------------------------
# OAUTH (future bonus)
# ------------------------------------------------------------------------------
# 42 Intra OAuth application credentials
FORTYTWO_CLIENT_ID=your_42_client_id
FORTYTWO_CLIENT_SECRET=your_42_client_secret
FORTYTWO_CALLBACK_URL=https://localhost/api/auth/42/callback

# Google OAuth (optional bonus)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# DOCKER BUILD
# ------------------------------------------------------------------------------
# Platform target for builds (useful for Apple Silicon: linux/amd64 or linux/arm64)
DOCKER_BUILDKIT=1
BUILDKIT_PROGRESS=plain
