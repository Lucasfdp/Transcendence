# ==============================================================================
# Shell Smash — Bootstrap environment
# ==============================================================================
# This file now contains only non-sensitive bootstrap configuration.
# Runtime secrets are seeded into Vault with:
#   make vault-init
#   make vault-unseal
#   make vault-seed-dev
# ==============================================================================

COMPOSE_PROJECT_NAME=transcendence

DOMAIN_NAME=localhost

HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MONITORING_PORT=3001
PORTAINER_PORT=9443

POSTGRES_DB=shellsmash
POSTGRES_USER=shellsmash
POSTGRES_INITDB_ARGS=--encoding=UTF8

BACKEND_ENV=development
JWT_EXPIRY=3600s
ALLOWED_ORIGINS=https://localhost
ENABLE_DEV_LOGIN=true

FRONTEND_ENV=development
VITE_API_URL=https://localhost/api
REACT_APP_API_URL=https://localhost/api
VITE_GITHUB_AUTH_URL=/api/auth/github

FORTYTWO_CALLBACK_URL=https://localhost/api/auth/42/callback
GITHUB_CALLBACK_URL=https://localhost/api/auth/github/callback

GF_ADMIN_USER=admin

LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

PROMETHEUS_SCRAPE_INTERVAL=15s

REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

SECRETS_WAIT_TIMEOUT=120
