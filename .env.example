# ==============================================================================
# Shell Smash — Bootstrap environment
# ==============================================================================
# This file now contains only non-sensitive bootstrap configuration.
# Runtime secrets are seeded into Vault with:
#   make vault-init
#   make vault-unseal
#   make vault-seed-dev
# ==============================================================================

COMPOSE_PROJECT_NAME=transcendence

# Use localhost for single-machine development. For LAN testing, set this to
# the host LAN IP, for example: DOMAIN_NAME=10.19.234.21
DOMAIN_NAME=localhost

# Only HTTPS_PORT is published to the host by default.
# Service-to-service ports are fixed inside Docker for predictable healthchecks.
HTTPS_PORT=42424
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MONITORING_PORT=3001
PORTAINER_PORT=9443

POSTGRES_DB=shellsmash
POSTGRES_USER=shellsmash
POSTGRES_INITDB_ARGS=--encoding=UTF8

BACKEND_ENV=development
JWT_EXPIRY=3600s
PUBLIC_API_KEY=change-me-public-api-key
# Add your LAN URL here when testing from other devices, for example:
# ALLOWED_ORIGINS=https://localhost:42424,https://localhost:3000,https://10.19.234.21:42424
ALLOWED_ORIGINS=https://localhost:42424,https://localhost:3000
# Shared demo account, seeded at startup and logged in via the normal login
# form. Always present in every environment — change or rotate these before any
# public deployment, since anyone with the credentials can log in.
DEMO_USERNAME=KameMaster
DEMO_PASSWORD=KameMaster42

FRONTEND_ENV=development
VITE_API_URL=/api
REACT_APP_API_URL=/api
FORTYTWO_CALLBACK_URL=https://localhost:42424/api/auth/42/callback
GOOGLE_CALLBACK_URL=https://localhost:42424/api/auth/google/callback

GF_ADMIN_USER=admin

LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

PROMETHEUS_SCRAPE_INTERVAL=15s

REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru

SECRETS_WAIT_TIMEOUT=120
# Maximum waiting time retained before the first replay action in each round.
REPLAY_ROUND_PREROLL_MS=3000
