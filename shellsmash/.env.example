# ==============================================================================
# ft_transcendence — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in every value before running make dev/up.
# NEVER commit .env — it is gitignored.  This example file is safe to commit.
#
# Usage:
#   cp .env.example .env
#   # edit .env, then:
#   make dev
# ==============================================================================

# ── Project ────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=transcendence

# ── Domain (used by Nginx) ─────────────────────────────────────────────────────
DOMAIN_NAME=localhost

# ── Ports ─────────────────────────────────────────────────────────────────────
HTTP_PORT=80
HTTPS_PORT=443
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MONITORING_PORT=3001
PORTAINER_PORT=9443

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
# All three are REQUIRED — empty values will prevent Postgres from initialising.
POSTGRES_DB=shellsmash
POSTGRES_USER=shellsmash
POSTGRES_PASSWORD=change_me_in_dot_env
POSTGRES_INITDB_ARGS=--encoding=UTF8

# ── Redis ─────────────────────────────────────────────────────────────────────
# REQUIRED — empty password is rejected by the custom Redis Dockerfile.
REDIS_PASSWORD=change_me_in_dot_env

# ── Backend ────────────────────────────────────────────────────────────────────
BACKEND_ENV=development
# JWT_SECRET MUST be set — NestJS will refuse to start without it.
# Any long random string works for local dev.
JWT_SECRET=change_me_in_dot_env_use_a_long_random_string
JWT_EXPIRY=3600s
SECRET_KEY=change_me_in_dot_env
ALLOWED_ORIGINS=https://localhost

# Dev-only login bypass — set to true to enable GET /api/auth/dev-login
ENABLE_DEV_LOGIN=true

# ── Frontend ───────────────────────────────────────────────────────────────────
FRONTEND_ENV=development
VITE_API_URL=https://localhost/api
REACT_APP_API_URL=https://localhost/api

# ── 42 OAuth (optional — leave blank to skip OAuth, use dev-login instead) ─────
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
FORTYTWO_CALLBACK_URL=

# ── Monitoring ─────────────────────────────────────────────────────────────────
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change_me_in_dot_env

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_DRIVER=json-file
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# ── Prometheus ─────────────────────────────────────────────────────────────────
PROMETHEUS_SCRAPE_INTERVAL=15s

# ── Redis tuning ───────────────────────────────────────────────────────────────
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=allkeys-lru
