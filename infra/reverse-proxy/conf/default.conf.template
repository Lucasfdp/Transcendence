server {
    listen ${HTTPS_PORT} ssl http2;
    server_name ${DOMAIN_NAME};

    # Nginx reports a plain HTTP request sent to this TLS-only port as internal
    # status 497. Replace its generic response with the branded secure-access
    # page while retaining a semantically accurate client status.
    error_page 497 =426 /https-required.html;

    ssl_certificate     /etc/nginx/ssl/cert.pem;
    ssl_certificate_key /etc/nginx/ssl/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    # unsafe-eval required by Phaser 3 shader pipeline (see https://phaser.io/phaser3 known limitations)
    # unsafe-inline (script-src) required until nonce-based CSP is implemented — tracked TODO(#csp-nonce)
    # unsafe-inline (style-src) required until CSS-in-JS is replaced with external stylesheets — tracked TODO(#csp-nonce)
    # img-src allows Klipy's three documented media-delivery hosts for chat GIFs
    # (see backend/src/modules/chat/gif.service.ts and
    # https://docs.klipy.com/network-requirements) — scoped to those exact hosts,
    # not a wildcard, since they're the only third-party image origins we render.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://static.klipy.com https://static1.klipy.com https://static2.klipy.com; font-src 'self' data:; connect-src 'self' http://localhost:3000 https://localhost:3000 https://localhost:42424 ws://localhost:3000 wss://localhost:3000 ws://localhost wss://localhost wss://localhost:42424 ${PUBLIC_HTTP_ORIGIN} ${PUBLIC_WS_ORIGIN};" always;

    location = /https-required.html {
        internal;
        modsecurity off;
        root /usr/share/nginx/html;
        default_type text/html;
        # The page is served once at build time with the CTA link left as the
        # literal token "__SECURE_ORIGIN__" (see the Dockerfile/entrypoint) so
        # it can be rewritten here, per request, from the Host header the
        # visitor actually used — a baked-in DOMAIN_NAME would send every
        # visitor back to https://localhost, which only resolves on the host
        # machine itself. text/html is sub_filter's built-in default type, so
        # no explicit sub_filter_types is needed here.
        sub_filter_once off;
        sub_filter '__SECURE_ORIGIN__' 'https://$http_host';
    }

    location / {
        modsecurity off;
        proxy_pass         http://frontend:3000;
        proxy_set_header   Host                $http_host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade             $http_upgrade;
        proxy_set_header   Connection          $connection_upgrade;
        # Vite HMR uses this upgraded connection in development. Keep it alive
        # like the game socket instead of closing remote clients every minute.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /api/auth/42/callback {
        modsecurity off;
        proxy_pass         http://backend:8000;
        proxy_set_header   Host                $http_host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_http_version 1.1;
    }

    location = /api/auth/google/callback {
        modsecurity off;
        proxy_pass         http://backend:8000;
        proxy_set_header   Host                $http_host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_http_version 1.1;
    }

	# Scalar, its local bundle, and both raw OpenAPI representations are one
	# protected documentation family. The subrequest reuses the caller's session
	# cookie and rejects guest accounts through the backend's normal guards.
	location ^~ /api/docs {
		auth_request /_api_docs_auth;
		modsecurity on;
		modsecurity_rules_file /etc/nginx/modsec/main.conf;
		proxy_pass         http://backend:8000;
		proxy_set_header   Host                $http_host;
		proxy_set_header   X-Real-IP           $remote_addr;
		proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
		proxy_set_header   X-Forwarded-Proto   $scheme;
		proxy_http_version 1.1;
		proxy_read_timeout 120s;
		limit_req zone=api_limit burst=60 nodelay;
		limit_req_status 429;
	}

	location = /_api_docs_auth {
		internal;
		proxy_pass              http://backend:8000/api/auth/docs-access;
		proxy_pass_request_body off;
		proxy_set_header        Content-Length "";
		proxy_set_header        Cookie $http_cookie;
		proxy_set_header        X-Original-URI $request_uri;
		proxy_set_header        X-Forwarded-Proto $scheme;
	}

	# The authorisation probe is an implementation detail, not a public API.
	location = /api/auth/docs-access {
		return 404;
	}

    location /api/ {
        modsecurity on;
        modsecurity_rules_file /etc/nginx/modsec/main.conf;
        proxy_pass         http://backend:8000;
        proxy_set_header   Host                $http_host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        limit_req zone=api_limit burst=60 nodelay;
        limit_req_status 429;
        client_max_body_size 10m;
    }

    location /ws/ {
        modsecurity off;
        proxy_pass         http://backend:8000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade             $http_upgrade;
        proxy_set_header   Connection          $connection_upgrade;
        proxy_set_header   Host                $http_host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /monitoring/ {
        modsecurity off;                 # Grafana's API traffic trips generic CRS rules; auth is Grafana's own
        proxy_pass         http://monitoring:3001;
        proxy_set_header   Host                $http_host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade             $http_upgrade;   # /monitoring/api/live/ websocket
        proxy_set_header   Connection          $connection_upgrade;
        proxy_read_timeout 120s;
        limit_req zone=api_limit burst=30 nodelay;              # brute-force mitigation on /login
        limit_req_status 429;
    }

    location /admin/ {
        modsecurity on;
        modsecurity_rules_file /etc/nginx/modsec/main.conf;
        proxy_pass         http://backend:8000;
        proxy_set_header   Host                $http_host;
        proxy_set_header   X-Real-IP           $remote_addr;
        proxy_set_header   X-Forwarded-For     $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto   $scheme;
        proxy_http_version 1.1;
        proxy_read_timeout 120s;
        limit_req zone=api_limit burst=20 nodelay;
        limit_req_status 429;
    }
}
