<!doctype html>
<html lang="en-GB">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="theme-color" content="#0a100d">
	<title>Secure connection required | ShellSmash</title>
	<style>
		@font-face {
			font-family: "Blowbrush";
			src: url("data:font/otf;base64,${BLOWBRUSH_FONT_DATA}") format("opentype");
			font-display: swap;
		}

		@font-face {
			font-family: "Rowdy";
			src: url("data:font/ttf;base64,${ROWDY_FONT_DATA}") format("truetype");
			font-display: swap;
		}

		:root {
			color-scheme: dark;
			--ink: #080405;
			--blood-black: #160608;
			--blood: #7f101b;
			--warning: #ed2939;
			--warning-light: #ff766c;
			--bone: #ead9cc;
			--ember: #f05a28;
			--text: #f6e9e2;
			--muted: #cbb4ae;
		}

		* {
			box-sizing: border-box;
		}

		html,
		body {
			min-height: 100%;
		}

		body {
			margin: 0;
			font-family: "Rowdy", "Palatino Linotype", Palatino, serif;
			color: var(--text);
			background:
				radial-gradient(circle at 50% 17%, rgba(237, 41, 57, 0.3) 0 7%, transparent 29%),
				linear-gradient(180deg, rgba(38, 4, 8, 0.24), rgba(5, 2, 3, 0.92)),
				linear-gradient(135deg, #330910 0%, #120608 47%, #050304 100%);
			overflow-x: hidden;
		}

		body::before {
			position: fixed;
			inset: auto -10vw -29vh;
			height: 65vh;
			background:
				linear-gradient(rgba(237, 41, 57, 0.1) 1px, transparent 1px),
				linear-gradient(90deg, rgba(237, 41, 57, 0.1) 1px, transparent 1px);
			background-size: 3.5rem 3.5rem;
			transform: perspective(680px) rotateX(62deg);
			transform-origin: bottom center;
			mask-image: linear-gradient(transparent, #000 38%);
			content: "";
			pointer-events: none;
		}

		body::after {
			position: fixed;
			inset: 0;
			background:
				repeating-linear-gradient(90deg, transparent 0 6.9rem, rgba(255, 71, 77, 0.035) 7rem),
				radial-gradient(circle at 50% 12%, transparent 0 20%, rgba(0, 0, 0, 0.56) 80%);
			content: "";
			pointer-events: none;
		}

		.page {
			position: relative;
			z-index: 1;
			display: grid;
			place-items: center;
			min-height: 100dvh;
			padding: clamp(1.25rem, 4vw, 3.5rem);
		}

		.shrine {
			position: relative;
			display: grid;
			grid-template-columns: minmax(9rem, 0.72fr) minmax(19rem, 35rem) minmax(9rem, 0.72fr);
			align-items: center;
			width: min(100%, 78rem);
		}

		.guardian {
			position: relative;
			z-index: 0;
			aspect-ratio: 4 / 5;
			margin: 0;
			overflow: hidden;
			border: 1px solid rgba(255, 75, 77, 0.5);
			background: #160608;
			box-shadow: 0 2rem 5rem rgba(0, 0, 0, 0.72), 0 0 2.5rem rgba(173, 13, 28, 0.22);
			filter: saturate(0.62) contrast(1.12) sepia(0.12) hue-rotate(318deg);
		}

		.guardian--left {
			margin-right: -2rem;
			transform: rotate(-2.5deg) translateY(1.4rem);
		}

		.guardian--right {
			margin-left: -2rem;
			transform: rotate(2.5deg) translateY(1.4rem);
		}

		.guardian::after {
			position: absolute;
			inset: 0;
			background: linear-gradient(180deg, rgba(74, 4, 10, 0.08) 38%, rgba(12, 2, 4, 0.9));
			box-shadow: inset 0 0 0 0.45rem rgba(22, 2, 5, 0.58);
			content: "";
		}

		.guardian img {
			display: block;
			width: 100%;
			height: 100%;
			object-fit: cover;
		}

		.notice {
			position: relative;
			z-index: 2;
			padding: clamp(2rem, 5vw, 3.8rem) clamp(1.5rem, 5vw, 4.2rem);
			border: 1px solid rgba(255, 74, 79, 0.72);
			border-radius: 1.6rem;
			background:
				linear-gradient(150deg, rgba(47, 8, 12, 0.98), rgba(8, 3, 4, 0.99)),
				var(--blood-black);
			box-shadow:
				0 2.5rem 7rem rgba(0, 0, 0, 0.78),
				0 0 4rem rgba(193, 15, 31, 0.24),
				inset 0 0 0 1px rgba(255, 104, 99, 0.12);
			text-align: center;
		}

		.notice::before,
		.notice::after {
			position: absolute;
			width: 2.1rem;
			height: 2.1rem;
			border-color: var(--warning-light);
			border-style: solid;
			content: "";
			opacity: 0.72;
		}

		.notice::before {
			top: 0.8rem;
			left: 0.8rem;
			border-width: 1px 0 0 1px;
		}

		.notice::after {
			right: 0.8rem;
			bottom: 0.8rem;
			border-width: 0 1px 1px 0;
		}

		.logo {
			display: block;
			width: min(100%, 19rem);
			height: auto;
			margin: -1.3rem auto 0.2rem;
			filter: drop-shadow(0 1rem 1.7rem rgba(0, 0, 0, 0.42));
		}

		.kicker {
			margin: 0 0 0.8rem;
			color: var(--warning-light);
			font-size: 0.76rem;
			letter-spacing: 0.28em;
			text-transform: uppercase;
		}

		h1 {
			margin: 0;
			font-family: "Blowbrush", "Rowdy", serif;
			font-size: clamp(2.9rem, 7vw, 5.3rem);
			font-weight: 400;
			line-height: 0.82;
			letter-spacing: 0.035em;
			text-transform: uppercase;
			text-shadow:
				0 0.2rem 0 rgba(24, 2, 4, 0.92),
				0 0 1.4rem rgba(237, 41, 57, 0.2),
				0 1rem 2rem rgba(0, 0, 0, 0.58);
		}

		.message {
			max-width: 29rem;
			margin: 1.25rem auto 0;
			color: var(--muted);
			font-size: clamp(1rem, 2vw, 1.15rem);
			line-height: 1.55;
		}

		.protocol {
			display: inline-flex;
			align-items: center;
			gap: 0.5rem;
			margin-top: 1.35rem;
			padding: 0.46rem 0.78rem;
			border: 1px solid rgba(255, 102, 96, 0.38);
			border-radius: 999px;
			background: rgba(5, 9, 7, 0.54);
			color: #f09a91;
			font-size: 0.82rem;
			letter-spacing: 0.08em;
		}

		.protocol::before {
			width: 0.55rem;
			height: 0.55rem;
			border-radius: 50%;
			background: var(--warning);
			box-shadow: 0 0 0.9rem rgba(237, 41, 57, 0.82);
			content: "";
		}

		.cta {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: min(100%, 22rem);
			margin-top: 1.35rem;
			padding: 0.95rem 1.25rem;
			border: 0;
			border-radius: 999px;
			background: linear-gradient(135deg, #ff6b4a, #b70d23 72%);
			box-shadow: 0 1rem 2.3rem rgba(0, 0, 0, 0.42), 0 0 1.8rem rgba(183, 13, 35, 0.2);
			color: #190306;
			font-family: "Rowdy", serif;
			font-weight: 700;
			letter-spacing: 0.12em;
			text-decoration: none;
			text-transform: uppercase;
			transition: transform 160ms ease, box-shadow 160ms ease, filter 160ms ease;
		}

		.cta:hover {
			transform: translateY(-2px);
			filter: brightness(1.07);
			box-shadow: 0 1.2rem 2.7rem rgba(0, 0, 0, 0.42);
		}

		.cta:focus-visible {
			outline: 3px solid var(--bone);
			outline-offset: 4px;
		}

		.hint {
			margin: 0.85rem 0 0;
			color: rgba(192, 185, 167, 0.7);
			font-size: 0.84rem;
		}

		@media (max-width: 56rem) {
			.shrine {
				grid-template-columns: minmax(0, 1fr);
				max-width: 36rem;
			}

			.guardian {
				position: absolute;
				top: 50%;
				width: min(46vw, 15rem);
				opacity: 0.42;
			}

			.guardian--left {
				left: -9vw;
				margin: 0;
				transform: translateY(-48%) rotate(-4deg);
			}

			.guardian--right {
				right: -9vw;
				margin: 0;
				transform: translateY(-48%) rotate(4deg);
			}

			.notice {
				margin: 0 clamp(0rem, 3vw, 1rem);
			}
		}

		@media (max-width: 35rem) {
			.page {
				padding: 1rem;
			}

			.notice {
				padding: 2.1rem 1.25rem;
				border-radius: 1.25rem;
			}

			.logo {
				width: min(75%, 15rem);
			}

			.guardian {
				display: none;
			}
		}

		@media (prefers-reduced-motion: reduce) {
			*,
			*::before,
			*::after {
				scroll-behavior: auto !important;
				animation-duration: 0.01ms !important;
				animation-iteration-count: 1 !important;
				transition-duration: 0.01ms !important;
			}
		}
	</style>
</head>
<body>
	<main class="page">
		<section class="shrine" aria-labelledby="page-title">
			<figure class="guardian guardian--left" aria-hidden="true">
				<img src="data:image/webp;base64,${SAMURAI_TURTLE_DATA}" alt="">
			</figure>

			<div class="notice">
				<img class="logo" src="data:image/png;base64,${SHELLSMASH_LOGO_DATA}" alt="ShellSmash">
				<p class="kicker">The courtyard is protected</p>
				<h1 id="page-title">HTTPS required</h1>
				<p class="message">
					This gate only opens through a secure connection. Your request used HTTP,
					so no account or game data was sent.
				</p>
				<div class="protocol">Secure route ready</div>
				<a class="cta" href="${SECURE_ORIGIN}">Enter with HTTPS</a>
				<p class="hint">You will return to the ShellSmash entrance.</p>
			</div>

			<figure class="guardian guardian--right" aria-hidden="true">
				<img src="data:image/webp;base64,${SUMO_TURTLE_DATA}" alt="">
			</figure>
		</section>
	</main>
</body>
</html>
